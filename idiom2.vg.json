{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Train Station Entry Volume Grid",
  "background": "#f9f9f9",
  "width": "container",
  "height": 400, 
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator",
    "center": [145, -37.86],
    "scale": 38000
  },
  "params": [
    {
      "name": "Peak_Selector",
      "value": "Pax_PM_peak",
      "bind": {
        "input": "radio",
        "options": ["Pax_AM_peak", "Pax_PM_peak"],
        "labels": ["AM Peak", "PM Peak"],
        "name": "Select Peak Period: "
      }
    }
  ],
  "layer": [
    {
      "description": "Choropleth Reference Base Context for Symbols",
      "data": {
        "url": "data/SA3_2016_AUST.topojson",
        "format": {"type": "topojson", "feature": "SA3_2016_AUST"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ddd",
        "stroke": "#bcbfca",
        "strokeWidth": 0.5
      }
    },
    {
      "description": "Proportional Symbol Map Layer mapping CSV Coordinates",
      "data": {
        "url": "data/annual_metropolitan_train_station_entries_fy_2024_2025.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {
          "calculate": "datum[Peak_Selector]",
          "as": "dynamic_peak_volume"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#333333",
        "strokeWidth": 0.8,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "Stop_long",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Stop_lat",
          "type": "quantitative"
        },
        "size": {
          "field": "Pax_annual",
          "type": "quantitative",
          "scale": {
            "type": "pow",
            "exponent": 0.7,
            "range":[15,1000],
            "domain": [400000, 20000000],
            "clamp": true
          },
          "title": "Annual Volume"
        },
        "color": {
          "field": "dynamic_peak_volume",
          "type": "quantitative",
          "scale": {
            "type": "pow",
            "exponent": 0.1,
            "scheme": "blues",
            "domainMin": 200,
            "domainMax": {
              "expr": "Peak_Selector == 'Pax_AM_peak' ? 20000 : 20000"
            },
            "rangeMin":20,
            "rangeMax":5000,
            "clamp": true
          },
          "title": "Peak Period Volume"
        },
        "tooltip": [
          {"field": "Stop_name", "type": "nominal", "title": "Station"},
          {"field": "Pax_annual", "type": "quantitative", "title": "Annual Patronage", "format": ","},
          {"field": "Pax_weekday", "type": "quantitative", "title": "Avg Weekday", "format": ","},
          {"field": "Pax_AM_peak", "type": "quantitative", "title": "AM Peak Volume", "format": ","},
          {"field": "Pax_PM_peak", "type": "quantitative", "title": "PM Peak Volume", "format": ","}
        ]
      }
    }
  ]
}