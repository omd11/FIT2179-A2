{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "background": "#f9f9f9",
  "spacing": 15,
  "resolve": {
    "scale": {"y": "shared"}
    
  },

  "hconcat": [
    {
      "title": "2023",
      "width": 500,
      "height": 400,
      "layer": [
        {
          "description": "2023 Train Layer",
          "data": {
            "url": "data/monthly_public_transport_patronage_by_mode.csv",
            "format": {
              "type": "csv",
              "parse": {
                "Year": "number",
                "Month": "number",
                "Metropolitan train": "number"
              }
            }
          },
          "transform": [
            {"filter": "datum.Year == 2023"},
            {"calculate": "datetime(2024, datum.Month - 1, 1)", "as": "Shared_Month"},
            {"aggregate": [{"op": "mean", "field": "Metropolitan train", "as": "Raw_Volume"}], "groupby": ["Shared_Month"]},
            {"joinaggregate": [{"op": "max", "field": "Raw_Volume", "as": "Max_Volume"}]},
            {"calculate": "datum.Raw_Volume / datum.Max_Volume", "as": "Normalized_Volume"},
            {"calculate": "'Metro Train'", "as": "Transport_Mode"}
          ],
          "mark": {
            "type": "line",
            "point": {"filled": true, "size": 60},
            "strokeWidth": 3
          },
          "encoding": {
            "x": {
              "field": "Shared_Month",
              "type": "temporal",
              "timeUnit": "month",
              "title": "Month",
              "axis": {"format": "%b", "labelAngle": 0, "grid": false, "tickCount": 12}
            },
            "y": {
              "field": "Normalized_Volume",
              "type": "quantitative",
              "title": "Relative Volume Retained (% of Peak Month)",
              "axis": {"format": ".0%", "gridDash": [4, 4]},
              "scale": {"domain": [0, 1.1]}
            },
            "color": {
              "field": "Transport_Mode",
              "type": "nominal",
              "scale": {"domain": ["Metro Train", "Active Cycling"], "range": ["#1f77b4", "#2ca02c"]},
              "legend": null
            },
            "tooltip": [
              {"field": "Shared_Month", "type": "temporal", "timeUnit": "month", "title": "Month"},
              {"field": "Transport_Mode", "type": "nominal", "title": "Mode"},
              {"field": "Normalized_Volume", "type": "quantitative", "title": "Volume Retained", "format": ".1%"}
            ]
          }
        },
        {
          "description": "2023 Bike Layer",
          "data": {
            "url": "data/black_rock_daily_volume.csv"
          },
          "transform": [
            {"filter": "year(toDate(datum.Date)) == 2023"},
            {"calculate": "datetime(2024, month(toDate(datum.Date)), 1)", "as": "Shared_Month"},
            {"aggregate": [{"op": "mean", "field": "Total_Network_Volume", "as": "Raw_Volume"}], "groupby": ["Shared_Month"]},
            {"joinaggregate": [{"op": "max", "field": "Raw_Volume", "as": "Max_Volume"}]},
            {"calculate": "datum.Raw_Volume / datum.Max_Volume", "as": "Normalized_Volume"},
            {"calculate": "'Active Cycling'", "as": "Transport_Mode"}
          ],
          "mark": {
            "type": "line",
            "point": {"filled": true, "size": 60},
            "strokeWidth": 3
          },
          "encoding": {
            "x": {
              "field": "Shared_Month",
              "type": "temporal",
              "timeUnit": "month"
            },
            "y": {
              "field": "Normalized_Volume",
              "type": "quantitative"
            },
            "color": {
              "field": "Transport_Mode",
              "type": "nominal",
              "legend": null
            },
            "tooltip": [
              {"field": "Shared_Month", "type": "temporal", "timeUnit": "month", "title": "Month"},
              {"field": "Transport_Mode", "type": "nominal", "title": "Mode"},
              {"field": "Normalized_Volume", "type": "quantitative", "title": "Volume Retained", "format": ".1%"}
            ]
          }
        }
      ]
    },
    {
      "title": "2024",
      "width": 500,
      "height": 400,
      "layer": [
        {
          "description": "2024 Train Layer",
          "data": {
            "url": "data/monthly_public_transport_patronage_by_mode.csv",
            "format": {
              "type": "csv",
              "parse": {
                "Year": "number",
                "Month": "number",
                "Metropolitan train": "number"
              }
            }
          },
          "transform": [
            {"filter": "datum.Year == 2024"},
            {"calculate": "datetime(2024, datum.Month - 1, 1)", "as": "Shared_Month"},
            {"aggregate": [{"op": "mean", "field": "Metropolitan train", "as": "Raw_Volume"}], "groupby": ["Shared_Month"]},
            {"joinaggregate": [{"op": "max", "field": "Raw_Volume", "as": "Max_Volume"}]},
            {"calculate": "datum.Raw_Volume / datum.Max_Volume", "as": "Normalized_Volume"},
            {"calculate": "'Metro Train'", "as": "Transport_Mode"}
          ],
          "mark": {
            "type": "line",
            "point": {"filled": true, "size": 60},
            "strokeWidth": 3
          },
          "encoding": {
            "x": {
              "field": "Shared_Month",
              "type": "temporal",
              "timeUnit": "month",
              "title": "Month",
              "axis": {"format": "%b", "labelAngle": 0, "grid": false, "tickCount": 12}
            },
            "y": {
              "field": "Normalized_Volume",
              "type": "quantitative"
            },
            "color": {
              "field": "Transport_Mode",
              "type": "nominal",
              "scale": {"domain": ["Metro Train", "Active Cycling"], "range": ["#1f77b4", "#2ca02c"]},
              "title": "Transport Mode",
              "legend": {
                "orient": "top-right",
                "fillColor": "#ffffff",
                "padding": 8,
                "cornerRadius": 5,
                "strokeColor": "#dddddd"
              }
            },
            "tooltip": [
              {"field": "Shared_Month", "type": "temporal", "timeUnit": "month", "title": "Month"},
              {"field": "Transport_Mode", "type": "nominal", "title": "Mode"},
              {"field": "Normalized_Volume", "type": "quantitative", "title": "Volume Retained", "format": ".1%"}
            ]
          }
        },
        {
          "description": "2024 Bike Layer",
          "data": {
            "url": "data/black_rock_daily_volume.csv"
          },
          "transform": [
            {"filter": "year(toDate(datum.Date)) == 2024"},
            {"calculate": "datetime(2024, month(toDate(datum.Date)), 1)", "as": "Shared_Month"},
            {"aggregate": [{"op": "mean", "field": "Total_Network_Volume", "as": "Raw_Volume"}], "groupby": ["Shared_Month"]},
            {"joinaggregate": [{"op": "max", "field": "Raw_Volume", "as": "Max_Volume"}]},
            {"calculate": "datum.Raw_Volume / datum.Max_Volume", "as": "Normalized_Volume"},
            {"calculate": "'Active Cycling'", "as": "Transport_Mode"}
          ],
          "mark": {
            "type": "line",
            "point": {"filled": true, "size": 60},
            "strokeWidth": 3
          },
          "encoding": {
            "x": {
              "field": "Shared_Month",
              "type": "temporal",
              "timeUnit": "month"
            },
            "y": {
              "field": "Normalized_Volume",
              "type": "quantitative"
            },
            "color": {
              "field": "Transport_Mode",
              "type": "nominal"
            },
            "tooltip": [
              {"field": "Shared_Month", "type": "temporal", "timeUnit": "month", "title": "Month"},
              {"field": "Transport_Mode", "type": "nominal", "title": "Mode"},
              {"field": "Normalized_Volume", "type": "quantitative", "title": "Volume Retained", "format": ".1%"}
            ]
          }
        }
      ]
    }
  ]
}