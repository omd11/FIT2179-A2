{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bimodal Transport Network Concatenated with Regional Choropleth",
  "background": "#f9f9f9",
  "hconcat": [
    {
      "title": {
        "text": "Bimodal Transport Network Layer",
        "subtitle": "Active cycling paths and train networks across Greater Melbourne",
        "subtitleColor": "#666666",
        "subtitleFontStyle": "italic"
      },
      "width": 500,
      "height": 500,
      "projection": {
        "type": "mercator",
        "center": [144.7, -37.86],
        "scale": 38000
      },
      "layer": [
        {
          "description": "LAYER 0: Victorian Regional/LGA Basemap Container",
          "data": {
            "url": "data/SA3_2016_AUST.json",
            "format": {"type": "topojson", "feature": "SA3_2016_AUST"}
          },
          "mark": {
            "type": "geoshape",
            "fill": "#ddd",
            "stroke": "#bcbfca",
            "strokeWidth": 1
          },
          "encoding": {
            "tooltip": [
              {"field": "properties.SA3_NAME16", "type": "nominal", "title": "Region"}
            ]
          }
        },
        {
          "description": "Layer 1: Bicycle Infrastructure Network (Base Network)",
          "data": {
            "url": "data/bicycle_infrastructure_network.topojson",
            "format": {"type": "topojson", "feature": "bicycle_infrastructure_network"}
          },
          "mark": {
            "type": "geoshape",
            "stroke": "#2ca02c", 
            "strokeWidth": 1.2,
            "opacity": 0.5,
            "fill": "transparent" 
          },
          "encoding": {
            "tooltip": [
              {"field": "properties.HwyType", "type": "nominal", "title": "Cycle Path"}
          ]
          }
        },
        {
          "description": "Layer 2: Public Transport LINES",
          "data": {
            "url": "data/public_transport_lines.json",
            "format": {"type": "json", "property": "features"}
          },
          "mark": {
            "type": "geoshape",
            "stroke": "#1f77b4", 
            "strokeWidth": 2.5,
            "opacity": 0.8,
            "fill": "transparent" 
          },
          "encoding": {
            "tooltip": [
              {"field": "properties.LONG_NAME", "type": "nominal", "title": "Transit Route"}
            ]
          }
        },
        {
          "description": "Layer 3: Public Transport STOPS (Placed on top)",
          "data": {
            "url": "data/public_transport_stops.geojson",
            "format": {"type": "json", "property": "features"}
          },
          "transform": [
            {
              "filter": "datum.properties.MODE == 'METRO TRAIN' || datum.properties.ROUTE_TYPE == 2"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#1f77b4", 
            "stroke": "#ffffff", 
            "strokeWidth": 0.3,
            "size": 0.00002
          },
          "encoding": {
            "tooltip": [
              {"field": "properties.STOP_NAME", "type": "nominal", "title": "Station/Stop"}
            ]
          }
        }
      ]
    },
    {
      "title": {
        "text": "Idiom 2: Train Station Entry Volume Grid",
        "subtitle": "Annual station entry volume mapped via proportional symbol channels",
        "subtitleColor": "#666666",
        "subtitleFontStyle": "italic"
      },
      "width": 500,
      "height": 500,
      "projection": {
        "type": "mercator",
        "center": [144.7, -37.86],
        "scale": 38000
      },
      "layer": [
        {
          "description": "Choropleth Reference Base Context for Symbols",
          "data": {
            "url": "data/SA3_2016_AUST.json",
            "format": {"type": "topojson", "feature": "SA3_2016_AUST"}
          },
          "mark": {
            "type": "geoshape",
            "fill": "#eaeaea",
            "stroke": "#ffffff",
            "strokeWidth": 0.5
          }
        },
        {
          "description": "Proportional Symbol Map Layer mapping CSV Coordinates",
          "data": {
            "url": "data/annual_metropolitan_train_station_entries_fy_2024_2025.csv",
            "format": {"type": "csv"}
          },
          "mark": {
            "type": "circle",
            "stroke": "#333333",
            "strokeWidth": 0.8,
            "opacity": 0.85
          },
          "encoding": {
            "longitude": {
              "field": "Stop_long",
              "type": "quantitative"
            },
            "latitude": {
              "field": "Stop_lat",
              "type": "quantitative"
            },
            "size": {
              "field": "Pax_annual",
              "type": "quantitative",
              "scale": {
                "range": [20, 600]
              },
              "title": "Annual Volume"
            },
            "color": {
              "field": "Pax_annual",
              "type": "quantitative",
              "scale": {
                "scheme": "blues"
              },
              "title": "Crowding Intensity"
            },
            "tooltip": [
              {"field": "Stop_name", "type": "nominal", "title": "Station"},
              {"field": "Pax_annual", "type": "quantitative", "title": "Annual Patronage", "format": ","},
              {"field": "Pax_weekday", "type": "quantitative", "title": "Avg Weekday", "format": ","},
              {"field": "Pax_AM_peak", "type": "quantitative", "title": "AM Peak Volume", "format": ","},
              {"field": "Pax_PM_peak", "type": "quantitative", "title": "PM Peak Volume", "format": ","}
            ]
          }
        }
      ]
    }
  ]
}