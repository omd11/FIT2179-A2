{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#f9f9f9",
  "data": {
    "url": "data/black_rock_daily_volume.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(timeFormat(datum.Date, '%U'))",
      "as": "Week_Number"
    },
    {
      "sort": [{"field": "Date"}],
      "window": [{
        "op": "mean", 
        "field": "Total_Network_Volume", 
        "as": "Smoothed_Volume"
      }],
      "frame": [-1, 1]
    }
  ],
  "facet": {
    "row": {
      "field": "Date",
      "timeUnit": "year",
      "type": "ordinal",
      "title": null,
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelPadding": 10
      }
    }
  },
  "spec": {
    "width": 475,
    "height": 50,
    "mark": {
      "type": "rect",
      "cornerRadius": 2,
      "stroke": "#ffffff",
      "strokeWidth": 1.5
    },
    "encoding": {
      "x": {
        "field": "Week_Number",
        "type": "ordinal",
        "title": "Week of the Year",
        "axis": {
          "labelExpr": "'Week ' + datum.value", 
          "labelAngle": -90,
          "labelOverlap": true,
          "tickSize": 0,
          "domain": false
        }
      },
      "y": {
        "field": "Date",
        "timeUnit": "day",
        "type": "ordinal",
        "title": null,
        "axis": {
          "format": "%a",
          "labelPadding": 8,
          "tickSize": 0,
          "domain": false
        }
      },
      "color": {
        "field": "Smoothed_Volume",
        "type": "quantitative",
        "title": "Total Daily Cyclists",
        "scale": {
          "scheme": "magma",
          "domain": [0, 3500],
          "clamp": true
        },
        "legend": {
          "direction": "horizontal",
          "orient": "bottom",
          "titleAnchor": "middle",
          "gradientLength": 200, 
          "titlePadding": 10
        }
      },
      "tooltip": [
        {
          "field": "Date",
          "timeUnit": "yearmonthdate",
          "type": "temporal",
          "title": "Date"
        },
        {
          "field": "Smoothed_Volume",
          "type": "quantitative",
          "title": "Smoothed Volume",
          "format": ",.0f"
        },
        {
          "field": "Total_Network_Volume",
          "type": "quantitative",
          "title": "Raw Daily Volume",
          "format": ","
        }
      ]
    }
  },
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "facet": {
      "spacing": 8 
    }
  }
}