{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Temporal Patronage and Commuter Mode Shift Dashboard",
  "background": "#f9f9f9",
  "width": "container",
  "height": 400, 
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/idiom4_commuter_shift.csv"
  },
  "transform": [
    {
      "filter": "datum.Day_Type == 'Weekend'"
    },
    {
      "calculate": "format(datum.Normalized_Volume, '.1f') + '%'",
      "as": "Retention_Label"
    }
  ],
  "encoding": {
    "x": {
      "field": "Transport_Mode",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 14,
        "labelFontWeight": "bold"
      }
    },
    "y": {
      "field": "Normalized_Volume",
      "type": "quantitative",
      "title": "Weekend Retention Rate (%)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "gridDash": [4, 4],
        "titlePadding": 10
      }
    },
    "color": {
      "field": "Transport_Mode",
      "type": "nominal",
      "legend": null, 
      "scale": {
        "domain": ["Metro Train", "Bicycle"],
        "range": ["#1f77b4", "#2ca02c"]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "width": {"band": 0.5} 
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "fontSize": 14,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "Retention_Label",
          "type": "nominal"
        },
        "tooltip": [
          {"field": "Transport_Mode", "type": "nominal", "title": "Mode"},
          {"field": "Normalized_Volume", "type": "quantitative", "title": "Weekend Retention (%)", "format": ".1f"}
        ]
      }
    }
  ]
}