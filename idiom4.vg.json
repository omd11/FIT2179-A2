{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Temporal Patronage and Commuter Mode Shift Dashboard",
  "background": "#f9f9f9",
  
  "title": {
    "text": "Idiom 4: Active vs. Rail Commuter Shift",
    "subtitle": "Normalized comparison of weekend vs. weekday mobility choices",
    "subtitleColor": "#666666",
    "subtitleFontStyle": "italic"
  },
  "width": 350,
  "height": 300,
  "data": {
    "url": "data/commuter_shift.csv" 
  },
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 3,
    "cornerRadiusTopRight": 3
  },
  "encoding": {
    "x": {
      "field": "Day_Type",
      "type": "nominal",
      "title": "Day Category",
      "axis": {"labelAngle": 0, "labelFontSize": 12}
    },
    "xOffset": {
      "field": "Transport_Mode",
      "type": "nominal"
    },
    "y": {
      "field": "Normalized_Volume",
      "type": "quantitative",
      "title": "Normalized Index (0-100)"
    },
    "color": {
      "field": "Transport_Mode",
      "type": "nominal",
      "title": "Transport Mode",
      "scale": {
        "domain": ["Metro Train", "Bicycle"],
        "range": ["#1f77b4", "#2ca02c"] 
      }
    },
    "tooltip": [
      {"field": "Transport_Mode", "type": "nominal", "title": "Mode"},
      {"field": "Day_Type", "type": "nominal", "title": "Day"},
      {"field": "Normalized_Volume", "type": "quantitative", "title": "Index Value", "format": ".1f"}
    ]
  }

  
}