{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400, 
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "background": "#f9f9f9",
  "data": {
    "url": "data/cycling_flow_continuous_paths.csv"
  },
  "params": [
    {
      "name": "Volume_Metric",
      "value": "Avg_Daily_Volume",
      "bind": {
        "input": "select",
        "options": [
          "Avg_Daily_Volume", 
          "Avg_Weekday_Volume", 
          "Avg_Weekend_Volume"
        ],
        "labels": [
          "Overall Daily Average", 
          "Average Weekday (Mon-Fri)", 
          "Average Weekend Day (Sat-Sun)"
        ],
        "name": "Select Temporal Metric: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "random()",
      "as": "jitter"
    },
    {
      "calculate": "datum[Volume_Metric]",
      "as": "Selected_Volume"
    }
  ],
  "mark": {
    "type": "circle",
    "stroke": "#ffffff",
    "strokeWidth": 0.5,
    "opacity": 0.75
  },
  "encoding": {
    "x": {
      "field": "Path_Type",
      "type": "nominal",
      "title": "Infrastructure Classification (Ranked Lowest to Highest Protection)",
      "sort": [
        "Shared street (sharrows)",
        "Basic painted lane",
        "Protected bike lane (on-road)",
        "Shared use path (off-road)",
        "Separated path (off-road)"
      ],
      "axis": {
        "labelAngle": -20,
        "labelFontSize": 8,
        "titlePadding": 15
      }
    },
    "xOffset": {
      "field": "jitter",
      "type": "quantitative",
      "axis": null
    },
    "y": {
      "field": "Selected_Volume",
      "type": "quantitative",
      "title": "Cyclist Volume (Based on Selection)",
      "scale": {
        "domain": [0, 2800] 
      },
      "axis": {
        "gridDash": [4, 4],
        "titlePadding": 10
      }
    },
    "size": {
      "field": "Continuous_Length_m",
      "type": "quantitative",
      "title": "Continuous Length (m)",
      "scale": {
        "range": [50, 1200]
      }
    },
    "color": {
      "field": "Path_Type",
      "type": "nominal",
      "legend": null, 
      "scale": {
        "domain": [
          "Shared street (sharrows)",
          "Basic painted lane",
          "Protected bike lane (on-road)",
          "Shared use path (off-road)",
          "Separated path (off-road)"
        ],
        "range": ["#d62728", "#ff7f0e", "#1f77b4", "#9467bd", "#2ca02c"]
      }
    },
    "tooltip": [
      {"field": "SITE_XN_ROUTE", "type": "nominal", "title": "Counter Site ID"},
      {"field": "Path_Name", "type": "nominal", "title": "Path Name"},
      {"field": "Path_Type", "type": "nominal", "title": "Infrastructure Type"},
      {"field": "Selected_Volume", "type": "quantitative", "title": "Selected Flow Metric", "format": ","},
      {"field": "Avg_Daily_Volume", "type": "quantitative", "title": "Avg. Overall Flow", "format": ","},
      {"field": "Continuous_Length_m", "type": "quantitative", "title": "Total Continuous Length (m)", "format": ",.0f"}
    ]
  }
}